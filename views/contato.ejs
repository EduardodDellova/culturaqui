<%- include('partials/topo', { css: ['/css/auth.css'] }) %>
<section class="wrap auth">
  <span class="tag">Fale com a gente</span>
  <h1>Contato</h1>
  <p class="lead">Dúvidas, sugestões ou parcerias? Envie sua mensagem.</p>
  <% if (erroGeral) { %><p class="alerta alerta--erro" role="alert"><%= erroGeral %></p><% } %>
  <form class="cartao" action="/contato" method="post" novalidate data-validar>
    <%- include('partials/campo', { id: 'nome', label: 'Nome', icone: 'user', placeholder: 'Seu nome', autocomplete: 'name', regras: 'obrigatorio|min:3|max:80' }) %>
    <%- include('partials/campo', { id: 'email', label: 'E-mail', icone: 'mail', tipo: 'email', placeholder: 'Seu e-mail', autocomplete: 'email', regras: 'obrigatorio|email' }) %>
    <%- include('partials/campo', { id: 'assunto', label: 'Assunto', tipo: 'select', regras: 'obrigatorio', opcoes: [
      { valor: 'duvida', texto: 'Dúvida' }, { valor: 'sugestao', texto: 'Sugestão' },
      { valor: 'parceria', texto: 'Parceria' }, { valor: 'outro', texto: 'Outro' }] }) %>
    <%- include('partials/campo', { id: 'mensagem', label: 'Mensagem', tipo: 'textarea', placeholder: 'Escreva sua mensagem', regras: 'obrigatorio|min:10|max:500', ajuda: 'De 10 a 500 caracteres.' }) %>
    <button class="btn btn--verde btn--bloco" type="submit">Enviar mensagem<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
  </form>
</section>
<%- include('partials/rodape') %>
