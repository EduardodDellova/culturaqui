<%- include('partials/topo', { css: ['/css/home.css', '/css/paginas.css'] }) %>
<section class="wrap pagina">
  <nav aria-label="Você está em"><ol class="migalhas"><li><a href="/">Início</a></li><li><a href="/eventos">Eventos</a></li><li aria-current="page"><%= evento.titulo %></li></ol></nav>
  <article class="detalhe">
    <div class="detalhe__arte"><%- include('partials/poster', { variant: evento.poster }) %></div>
    <div class="detalhe__info">
      <span class="tag"><%= evento.categoriaNome %></span>
      <h1><%= evento.titulo %></h1>
      <p class="lead"><%= evento.resumo %></p>
      <dl class="dados">
        <div><dt><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg>Local</dt><dd><%= evento.local %></dd></div>
        <div><dt><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>Quando</dt><dd><%= evento.quando %></dd></div>
        <div><dt><svg class="icon" aria-hidden="true"><use href="#i-sparkles"/></svg>Pontos</dt><dd><%= evento.pontos %> pontos</dd></div>
      </dl>
      <p><%= evento.descricao %></p>
      <a class="btn btn--verde" href="<%= usuario ? '/perfil' : '/cadastro' %>"><%= usuario ? 'Ver meus pontos' : 'Criar conta para participar' %><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <p class="nota">* Evento de exemplo. Não há venda de ingressos.</p>
    </div>
  </article>
  <% if (parecidos.length) { %>
  <h2 class="secao__sub">Você também pode gostar</h2>
  <ul class="cards"><% parecidos.forEach(function (e) { %><%- include('partials/evento-card', { e: e }) %><% }) %></ul>
  <% } %>
</section>
<%- include('partials/rodape') %>
