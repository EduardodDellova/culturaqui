# Copie este arquivo para ".env" (local) ou cadastre as variáveis no serviço de hospedagem.
# Segredo usado para assinar o cookie de sessão. Use um texto longo e aleatório.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
# Porta local (na hospedagem a porta é definida automaticamente)
PORT=3000
# Em produção use: production
NODE_ENV=development
# Destino das mensagens enviadas pelo formulário de contato
EMAIL_DESTINO=culturaquii@gmail.com
# Dados SMTP fornecidos pelo serviço de e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
